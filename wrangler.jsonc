{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modus-signal",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "COMPANY",
        "class_name": "Company"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Company"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "*/30 * * * *"
    ]
  },
  "vars": {
    "MAX_STORAGE_MB": "900",
    "PUBLIC_URL": "https://your-worker.your-subdomain.workers.dev",
    "BOT_USERNAME": "",
    "TELEGRAM_GROUP_ID": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
