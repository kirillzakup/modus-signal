# МОДУС · СИГНАЛ — переменные окружения (внешних зависимостей нет, достаточно Node.js >= 22)

# Порт и интерфейс HTTP-сервера
PORT=8080
HOST=0.0.0.0

# Каталог для SQLite-базы (создаётся автоматически: ${DATA_DIR}/modus.db)
DATA_DIR=./data

# Демо-режим: 1 — вход по заголовку X-Demo-User, выбор роли в боте, сброс данных /api/admin/reset;
# 0 — только Telegram (Authorization: tma <initData>), привязка аккаунта по коду LINK_CODE_<userId>
DEMO=1

# Коды привязки Telegram-аккаунта к сотруднику (нужны только при DEMO=0).
# Сотрудник вводит код в Mini App (POST /api/tg/link) или в боте: /link u1 7F3K-91QA
# LINK_CODE_u1=7F3K-91QA
# LINK_CODE_m1=Q2W8-ZX11

# Telegram-бот: токен от @BotFather. Без токена бот не запускается, вход через Mini App недоступен
BOT_TOKEN=
# HTTPS-адрес, по которому опубликовано приложение (кнопка меню и web_app-кнопки)
PUBLIC_URL=https://signal.example.ru
# 0 — не запускать long polling (проверка initData при этом работает)
BOT_POLLING=1

# CORS: разрешённый источник для API (по умолчанию *)
CORS_ORIGIN=*

# Битрикс24 (необязательно): входящий вебхук с правами task
# B24_WEBHOOK=https://portal.bitrix24.ru/rest/1/abcdef1234567890/
# Сопоставление сотрудников Сигнала с ID пользователей Б24; "default" — исполнитель по умолчанию
# B24_USER_MAP={"m1":12,"m2":15,"default":1}

# Часовой пояс для дат в уведомлениях и CSV
# TZ=Asia/Almaty  (или Europe/Moscow — по месту работы компании)

# Служебное: интервал проверки SLA (мс, по умолчанию 600000) и рассылки уведомлений (мс, 15000)
# TICK_MS=600000
# DISPATCH_MS=15000

# ── ИИ-агент собственника (необязательно; без ключа — отчёт по правилам) ──
# Провайдер: anthropic (по умолчанию при наличии ключа) или openai (любой OpenAI-совместимый API:
# OpenAI, OpenRouter, vLLM, Ollama, шлюзы к YandexGPT/GigaChat)
# LLM_PROVIDER=anthropic
# Ключ (запасные варианты: ANTHROPIC_API_KEY / OPENAI_API_KEY)
# LLM_API_KEY=
# Модель (по умолчанию claude-sonnet-5-5 / gpt-4o-mini)
# LLM_MODEL=claude-sonnet-5-5
# Базовый адрес (по умолчанию https://api.anthropic.com / https://api.openai.com/v1)
# Пример локальной модели: LLM_PROVIDER=openai LLM_BASE_URL=http://127.0.0.1:11434/v1 LLM_MODEL=qwen2.5:14b
# LLM_BASE_URL=
# LLM_MAX_TOKENS=1500

# ── Фильтр собственника и публичная форма ──
# 1 (по умолчанию) — каждое новое обращение сначала разбирает собственник: «В работу» или «В корзину».
# 0 — прежняя схема: обращение сразу уходит ответственному по категории.
# OWNER_TRIAGE=1
# Сколько обращений по публичной ссылке принимается с одного адреса в час (защита от спама)
# PUBLIC_PER_HOUR=5
# 1 — сервер стоит за обратным прокси: адрес клиента берётся из заголовка X-Forwarded-For
# TRUST_PROXY=0

# Час ежедневного отчёта собственнику (локальное время сервера по TZ), 0–23
REPORT_HOUR=9

# Личный помощник и анализ отчётов (нужен баланс DeepSeek)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
